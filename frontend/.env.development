# Loaded by `npm start` only. See .env.example for what each name means and
# for how to override these on a single machine (.env.local).

# Host-relative, same as the production build -- which only works because of
# the "proxy" field in package.json.
#
# The dev server is on :3000 and Apache is on :80, so a relative path would
# normally hit the dev server, which has no PHP. The proxy forwards anything
# the dev server does not recognise on to Apache: webpack-dev-middleware is
# registered ahead of the proxy, so the bundle and hot-reload socket are served
# locally, and only requests like /Capstone2/frontend/backend/api/login.php
# fall through.
#
# The point of doing it this way rather than naming an absolute URL is that the
# page and the API end up on the SAME origin as far as the browser is
# concerned. So `npm start` now works from any device that can reach this
# machine -- a phone on the same Wi-Fi, or a forwarded port -- instead of only
# from the machine itself. It also means no CORS preflight in development, and
# react-dev-utils rewrites the Origin header to the proxy target on the way
# through, so the localhost allowance in hris_configure_cors() still matches.
REACT_APP_API_BASE_URL=/Capstone2/frontend/backend/api

# Setting "proxy" above turns ON the dev server's host check as a side effect
# (react-scripts: `disableFirewall = !proxy || DANGEROUSLY_DISABLE_HOST_CHECK`),
# which would then reject any request whose Host header is not this machine's
# LAN address -- exactly the port-forwarded case this is meant to support.
#
# What the check defends against is DNS rebinding: a page on the open web
# pointing a hostname it controls at your address to read what the dev server
# serves. Turning it off is a real, if narrow, loss.
#
# Drop this line if you only ever open the dev server from this machine or over
# the LAN; the host check allows the LAN address on its own. It is needed only
# for a forwarded port or a tunnel hostname. Better still, do not expose the
# dev server at all -- it serves uncompiled source and bypasses every .htaccess
# in the project, since it is not Apache. Port 80 and `npm run build` are the
# right way to publish this.
DANGEROUSLY_DISABLE_HOST_CHECK=true
