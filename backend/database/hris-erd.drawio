        <mxCell id="ov_title" value="HRIS Database: Entity Relationship Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="ov_subtitle" value="Generated from the hris database schema (MariaDB 10.4.32) on Oct 5, 2026 · 52 tables · 76 relationships (47 with FOREIGN KEY constraints, 29 kept by the application). A login account (users) belongs to the employee record with the same email: the dashed line between users.email and employees.email. Each module also has its own page (tabs at the bottom of draw.io)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1100" height="44" as="geometry"/></mxCell>
