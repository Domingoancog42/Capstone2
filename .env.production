# Loaded by `npm run build` only. See .env.example for what each name means and
# for how to override these on a single machine (.env.local).

# Host-relative on purpose: the built bundle has to work for whoever loads it,
# from whatever address they used. Hard-coding localhost here is what makes a
# build appear to work on the server and fail on every other device.
#
# This assumes the build is served as .../Capstone2/frontend/build/ with the
# backend still at .../Capstone2/frontend/backend/. Serving the build from the
# document root instead makes this "/backend/api".
REACT_APP_API_BASE_URL=/Capstone2/frontend/backend/api

# Relative asset paths, so build/ can be copied anywhere and still resolve
# /static/js/... correctly.
PUBLIC_URL=.

# Do not ship the readable source of the whole app.
GENERATE_SOURCEMAP=false

# Keep webpack's runtime in a file of its own instead of inlining it into
# index.html as a <script> block. The bundle currently builds as a single entry
# chunk so nothing is inlined either way, but that depends on how the app
# happens to split -- and the day it splits differently, an inlined runtime
# would be an inline script, which the Content-Security-Policy in
# frontend/public/.htaccess refuses. Turning it off here means script-src can
# stay at a strict 'self' without a rebuild being able to break the app.
INLINE_RUNTIME_CHUNK=false
