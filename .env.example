# ---------------------------------------------------------------------------
# Template. The committed defaults live in .env.development (used by
# `npm start`) and .env.production (used by `npm run build`) -- you do not need
# to copy this file for the app to work.
#
# Copy it to .env.local only when THIS machine needs different values than the
# committed ones. Create React App loads .env.local for both `start` and
# `build`, and it wins over .env.development / .env.production, so it is the
# right place for a personal override and the wrong place for a shared one.
#
# Two rules that catch people out:
#
#   1. Only names beginning with REACT_APP_ are exposed to the React code.
#      PUBLIC_URL and GENERATE_SOURCEMAP are read by react-scripts itself and
#      are the documented exceptions.
#   2. These values are compiled into the JavaScript bundle, which anyone can
#      read. Nothing secret goes in here -- SMTP credentials, database
#      passwords and the like belong in the PHP layer. See
#      backend/api/smtp-credentials.example.php.
#
# Changing any of these requires restarting `npm start`; the dev server reads
# them once at boot.
# ---------------------------------------------------------------------------

# Where the PHP API lives, as seen by the BROWSER -- not by the server.
#
# Keep it host-relative ("/Capstone2/frontend/backend/api"). It then follows
# whatever hostname the user actually typed, so one bundle works on localhost,
# on a LAN address like http://192.168.1.10/..., and through a forwarded port
# or tunnel, with no rebuild. It also puts the API on the same origin as the
# page, which sidesteps CORS entirely.
#
# This works in development too, via the "proxy" field in package.json, which
# forwards anything the dev server does not recognise on to Apache on :80.
#
# An absolute value ("http://localhost/Capstone2/frontend/backend/api") pins
# the API to one host and is the mistake to avoid: the page loads for a remote
# device, then every API call resolves "localhost" to THAT device and fails
# with a connection error rather than an HTTP status.
#
# If you serve the build from the document root instead of a subfolder, this
# becomes "/backend/api".
REACT_APP_API_BASE_URL=/Capstone2/frontend/backend/api

# Prefix for the bundle's own assets (/static/js/..., the icons, manifest.json).
#
# "." emits relative paths, so build/ works from whatever folder Apache serves
# it out of. An absolute path such as "/Capstone2/frontend/build" pins it, which
# is only worth doing if you add client-side routing later -- relative paths
# break once the URL can have extra path segments below the app root.
#
# Ignored by `npm start`, which always serves from /.
PUBLIC_URL=.

# Source maps reconstruct the entire readable source of the app in the
# browser's devtools. Fine locally, not something to publish on a machine
# reachable from outside.
GENERATE_SOURCEMAP=false
